PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
CLIENT_URLS=http://localhost:5173,https://your-frontend.onrender.com

# Simli real-time lip-sync avatar (API key stays on the server)
SIMLI_API_KEY=your_simli_api_key
SIMLI_FACE_ID=your_simli_face_id

# Optional Gemini text-to-speech model; default: gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Warm, friendly female Gemini TTS voice. Other supported option: Aoede
GEMINI_TTS_VOICE=Sulafat
